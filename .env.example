# As credenciais da Growatt agora são cadastradas pelo navegador (vault local
# criptografado) e enviadas ao servidor apenas para abrir a sessão de cada
# conta — não ficam mais neste arquivo.

# Intervalo (em segundos) entre consultas ao servidor da Growatt, por conta.
# Evite valores muito baixos para não ser bloqueado pelo servidor.
GROWATT_POLL_INTERVAL=30

# Porta local onde o servidor Flask vai rodar.
PORT=5000

# true para habilitar o debugger do Flask (não recomendado se o servidor
# estiver exposto na rede, como em um container Docker).
FLASK_DEBUG=false

# true para servir em HTTPS com certificado autoassinado (requer o pacote
# pyOpenSSL). Necessário para acessar o vault de outro aparelho na rede
# (não localhost) — veja o README, seção "Acessar de outro aparelho na rede".
FLASK_SSL_ADHOC=false
